{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "PatientBookingApi",
    "Audience": "PatientBookingApiClient",
    "DurationInMinutes": 15,
    "RefreshTokenDurationInDays": 7,
    "AbsoluteRefreshSessionDurationInDays": 30
  },
  "EmailSettings": {
    "SmtpHost": "localhost",
    "SmtpPort": 2525,
    "SenderName": "Patient Booking API",
    "SenderEmail": "no-reply@industrialhinterlands.cloud"
  },
  // Secret teehee. Base64-encoded value at least 32bytes decoded.
  "LookupProtection": {
    "Key": ""
  },
  // Empty by default. PersonalDataProtector falls back to a "keys" folder.
  "DataProtection": {
    "KeyPath": ""
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  }
}
