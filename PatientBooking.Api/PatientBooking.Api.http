@PatientBooking.Api_HostAddress = https://localhost:7195
@json = application/json

### 0 ADMIN SETUP (one-time, run before sections 4-6)

# @name adminRegister
POST {{PatientBooking.Api_HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "Email": "admin1@email.com",
  "Password": "Password!!!123",
  "FirstName": "John",
  "LastName": "Last"
}

###
# userId below comes straight from the register response. token comes from the
# confirmation email (or Logs/log-.txt if no SMTP is configured locally).
@adminUserId = {{adminRegister.response.body.$.Id}}
@adminConfirmToken = REPLACE_WITH_EMAIL_TOKEN
GET {{PatientBooking.Api_HostAddress}}/api/auth/confirm-email?userId={{adminUserId}}&token={{adminConfirmToken}}

###
# Run this only after the user-secret + restart above.
# @name adminLogin
POST {{PatientBooking.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "Email": "admin1@email.com",
  "Password": "Password!!!123"
}

@adminToken = {{adminLogin.response.body.$.token}}

### 1 PATIENT — register, confirm, login, 2FA (optional)

# @name patientRegister
POST {{PatientBooking.Api_HostAddress}}/api/auth/register
Content-Type: {{json}}

{
  "Email": "patient1@email.com",
  "Password": "Password!!!123",
  "FirstName": "Jane",
  "LastName": "Doe"
}

###

@patientUserId = {{patientRegister.response.body.$.Id}}
@patientConfirmToken = REPLACE_WITH_EMAIL_TOKEN
GET {{PatientBooking.Api_HostAddress}}/api/auth/confirm-email?userId={{patientUserId}}&token={{patientConfirmToken}}

###

POST {{PatientBooking.Api_HostAddress}}/api/auth/resend-confirmation
Content-Type: {{json}}

{
  "Email": "patient1@email.com"
}

###
# @name patientLogin
POST {{PatientBooking.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "Email": "patient1@email.com",
  "Password": "Password!!!123"
}

@patientToken = {{patientLogin.response.body.$.token}}
@patientPendingToken = {{patientLogin.response.body.$.pendingToken}}

###
# Optional branch below — skip straight to section 2 if not demoing 2FA.
# Returns sharedKey + authenticatorUri to seed an authenticator app with.
GET {{PatientBooking.Api_HostAddress}}/api/auth/2fa/setup
Authorization: Bearer {{patientToken}}

###

POST {{PatientBooking.Api_HostAddress}}/api/auth/2fa/enable
Authorization: Bearer {{patientToken}}
Content-Type: {{json}}

{
  "Code": "REPLACE_WITH_TOTP_CODE"
}

###
# Once 2FA is enabled, patientLogin above returns RequiresTwoFactor + pendingToken
# instead of a token. Exchange pendingToken + a fresh TOTP code for the real one here.
POST {{PatientBooking.Api_HostAddress}}/api/auth/2fa/login
Authorization: Bearer {{patientPendingToken}}
Content-Type: {{json}}

{
  "Code": "REPLACE_WITH_TOTP_CODE"
}

### 2 BOOKING — browse clinics, then Patient CRUD

GET {{PatientBooking.Api_HostAddress}}/api/clinic

###

@existingClinicId = 1
GET {{PatientBooking.Api_HostAddress}}/api/clinic/{{existingClinicId}}

###
# GetBookingDto deliberately never exposes the internal booking Id (BookingNumber
# is the public identifier) - grab the id below from the list response.
POST {{PatientBooking.Api_HostAddress}}/api/booking
Authorization: Bearer {{patientToken}}
Idempotency-Key: {{$guid}}
Content-Type: {{json}}

{
  "ClinicId": 1,
  "AppointmentStartUtc": "2026-09-15T09:00:00Z"
}

###

GET {{PatientBooking.Api_HostAddress}}/api/booking
Authorization: Bearer {{patientToken}}

###

@bookingId = 1
GET {{PatientBooking.Api_HostAddress}}/api/booking/{{bookingId}}
Authorization: Bearer {{patientToken}}

###

DELETE {{PatientBooking.Api_HostAddress}}/api/booking/{{bookingId}}
Authorization: Bearer {{patientToken}}

### 3 EMPLOYEE — Admin provisions, employee logs in directly

# @name createEmployee
POST {{PatientBooking.Api_HostAddress}}/api/employees
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "Email": "employee1@email.com",
  "Password": "Password!!!123",
  "FirstName": "Sam",
  "LastName": "Staff",
  "ClinicId": 1
}

@employeeId = {{createEmployee.response.body.$.Id}}

###
# @name employeeLogin
POST {{PatientBooking.Api_HostAddress}}/api/auth/login
Content-Type: {{json}}

{
  "Email": "employee1@email.com",
  "Password": "Password!!!123"
}

@employeeToken = {{employeeLogin.response.body.$.token}}

###

GET {{PatientBooking.Api_HostAddress}}/api/employees
Authorization: Bearer {{adminToken}}

###

GET {{PatientBooking.Api_HostAddress}}/api/employees/{{employeeId}}
Authorization: Bearer {{adminToken}}

###

PUT {{PatientBooking.Api_HostAddress}}/api/employees/{{employeeId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "ClinicId": 1
}

###

DELETE {{PatientBooking.Api_HostAddress}}/api/employees/{{employeeId}}
Authorization: Bearer {{adminToken}}

### 4 CLINIC — full Admin CRUD, including operating hours

# @name createClinic
POST {{PatientBooking.Api_HostAddress}}/api/clinic
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "Name": "Clinic06",
  "Address": "789 Address Street"
}

@newClinicId = {{createClinic.response.body.$.Id}}

###

PUT {{PatientBooking.Api_HostAddress}}/api/clinic/{{newClinicId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "Name": "Clinic06",
  "Address": "790 Address Street"
}

###

GET {{PatientBooking.Api_HostAddress}}/api/clinic/{{newClinicId}}/operating-hours

###

PUT {{PatientBooking.Api_HostAddress}}/api/clinic/{{newClinicId}}/operating-hours
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

[
  { "DayOfWeek": "Sunday", "OpenTime": null, "CloseTime": null },
  { "DayOfWeek": "Monday", "OpenTime": "09:00:00", "CloseTime": "17:00:00" },
  { "DayOfWeek": "Tuesday", "OpenTime": "09:00:00", "CloseTime": "17:00:00" },
  { "DayOfWeek": "Wednesday", "OpenTime": "09:00:00", "CloseTime": "17:00:00" },
  { "DayOfWeek": "Thursday", "OpenTime": "09:00:00", "CloseTime": "17:00:00" },
  { "DayOfWeek": "Friday", "OpenTime": "09:00:00", "CloseTime": "17:00:00" },
  { "DayOfWeek": "Saturday", "OpenTime": "09:00:00", "CloseTime": "17:00:00" }
]

###

DELETE {{PatientBooking.Api_HostAddress}}/api/clinic/{{newClinicId}}
Authorization: Bearer {{adminToken}}

### 5 STAFF BOOKING — Employee books on a patient's behalf

GET {{PatientBooking.Api_HostAddress}}/api/clinic/{{existingClinicId}}/booking
Authorization: Bearer {{employeeToken}}

###

POST {{PatientBooking.Api_HostAddress}}/api/clinic/{{existingClinicId}}/booking
Authorization: Bearer {{employeeToken}}
Idempotency-Key: {{$guid}}
Content-Type: {{json}}

{
  "PatientId": 1,
  "AppointmentStartUtc": "2026-09-16T10:00:00Z"
}

###

GET {{PatientBooking.Api_HostAddress}}/api/clinic/{{existingClinicId}}/booking/{{bookingId}}
Authorization: Bearer {{employeeToken}}

###

DELETE {{PatientBooking.Api_HostAddress}}/api/clinic/{{existingClinicId}}/booking/{{bookingId}}
Authorization: Bearer {{employeeToken}}
