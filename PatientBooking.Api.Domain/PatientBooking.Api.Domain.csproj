<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>

	  <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	  <WarningLevel>9999</WarningLevel>
	  <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

	  <!-- AnalysisLevel/AnalysisMode inherited from Directory.Build.props (latest / recommended) -->
	  <EnableNETAnalyzers>true</EnableNETAnalyzers>

	  <!-- Meziantou left at its default rule set: keeps the high-value async/correctness/
		security rules at warning, drops stylistic pedantry (trailing commas, record-class
		spelling, filename matching). 'all-warnings' promotes every rule and was pure noise
		for a learning project. -->

	  <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- All analyzers are applied globally via Directory.Build.props -->
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\PatientBooking.Api.Common\PatientBooking.Api.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Configurations\" />
	  <Folder Include="Migrations\" />
	  <Folder Include="Security\" />
	  <Folder Include="SQL Scripts\" />
	</ItemGroup>

</Project>
