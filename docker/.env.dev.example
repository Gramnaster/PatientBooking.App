# Copy to docker/.env.dev (gitignored) and adjust only what collides with something else
# already running on this machine. Every value below already has a working default baked into
# dev.compose.yaml, so an empty docker/.env.dev file is a valid starting point.

MSSQL_SA_PASSWORD=YourStrong@Passw0rd
SQLSERVER_PORT=1433

POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

SEQ_UI_PORT=5341

SMTP_PORT=2525
SMTP_UI_PORT=5000

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
