# Copy to .env (gitignored) and fill in real values - never commit .env itself.
MSSQL_SA_PASSWORD=
JWT_SETTINGS_KEY=
# Base64-encoded value, at least 32 bytes decoded - e.g. `openssl rand -base64 32`
LOOKUP_PROTECTION_KEY=
# Real SMTP relay for production (SendGrid, Mailgun, SES, etc.) - appsettings.json's
# localhost:2525 default is a local dev catcher only and will not deliver mail from the VPS.
EMAIL_SETTINGS_SMTP_HOST=
EMAIL_SETTINGS_SMTP_PORT=
EMAIL_SETTINGS_USERNAME=
EMAIL_SETTINGS_PASSWORD=
GOOGLE_CLIENT_ID=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Optional initial admin: use an unused email. Existing non-admin users are never promoted.
# Supply all four on first deployment. Remove the password after successful creation.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=
